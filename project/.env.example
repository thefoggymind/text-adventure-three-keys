# Community Keeper - Discord Bot 環境変数

# Discord Bot Token（必須）
# Discord Developer Portal (https://discord.com/developers/applications) で
# Botを作成し、Settings > Bot > Token から取得してください。
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# データベース保存先ディレクトリ（省略可）
# 指定しない場合、project/data/ が自動的に作成され使用されます。
# DATABASE_PATH=./data